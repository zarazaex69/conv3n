{
  "name": "custom/example",
  "type": "custom/example",
  "description": "Example custom block demonstrating SDK usage",
  "scriptPath": "custom/example_block.ts",
  "category": "custom",
  "inputs": [
    {
      "name": "main",
      "description": "Main input port"
    }
  ],
  "outputs": [
    {
      "name": "default",
      "description": "Default output port"
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "description": "Message to process"
      },
      "multiplier": {
        "type": "number",
        "description": "How many times to repeat the message",
        "default": 1
      }
    },
    "required": ["message"]
  }
}
